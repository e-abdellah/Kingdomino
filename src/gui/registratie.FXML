<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.WelkomKDController">
    <DialogPane>
        <headerText>Voer de gegevens van de nieuwe speler in:</headerText>
        <content>
            <GridPane hgap="10" vgap="10">
                <children>
                    <Label text="Gebruikersnaam:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="gebruikersnaam" promptText="Gebruikersnaam" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label fx:id="gebruikersnaamFout" style="-fx-text-fill: red;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    
                    <Label text="Geboortejaar:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="geboortejaar" promptText="Geboortejaar" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label fx:id="geboortejaarFout" style="-fx-text-fill: red;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </children>
            </GridPane>
        </content>
        <buttonTypes>
            <ButtonType text="Registreer" />
            <ButtonType text="Annuleer" fx:id="cancelButton" />
        </buttonTypes>
    </DialogPane>
</VBox>
